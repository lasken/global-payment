{
  "rewrites": [
    { "source": "/howtoguides/:cat/:slug", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/marketplace/vendorlist/:slug", "destination": "/index.html" },
    { "source": "/marketplace/:tab", "destination": "/index.html" },
    { "source": "/financial/:tab", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
